Dim horas As Single
Dim minutos As Single
Dim segundos As Single

Input "Insira a quantidade de horas para serem convertidas", horas

minutos = horas * 60
segundos = horas * 3600

Print "Valor original em horas: "; horas
Print "Valor equivalente em minutos: "; minutos
Print "Valor equivalente em segundos: "; segundos

Sleep